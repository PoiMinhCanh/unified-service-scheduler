{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "StackExchange.Redis": "Warning"
    }
  },
  "Scheduler": {
    "Telemetry": {
      "Enabled": false,
      "OtlpEndpoint": "http://127.0.0.1:4317",
      "SamplingRatio": 1.0,
      "ServiceName": "unified-service-scheduler-api",
      "ServiceInstanceId": "scheduler-api",
      "TraceBatchDelayMilliseconds": 1000,
      "TraceExportTimeoutMilliseconds": 5000,
      "TraceBatchQueueSize": 2048,
      "TraceBatchSize": 512,
      "OtlpTimeoutMilliseconds": 3000,
      "MetricExportIntervalMilliseconds": 5000,
      "MetricExportTimeoutMilliseconds": 3000
    },
    "Cache": {
      "ServiceCatalog": {
        "AbsoluteTtl": "00:10:00"
      },
      "OperationTimeout": "00:00:00.250",
      "ConnectTimeout": "00:00:00.500",
      "CommandTimeout": "00:00:00.500",
      "ConnectRetry": 1
    },
    "Booking": {
      "MaxCandidateAttempts": 5,
      "MaxDeadlockRetries": 2,
      "RetryDelayMilliseconds": 50,
      "RequestBudgetSeconds": 20,
      "CommandTimeoutSeconds": 10
    }
  },
  "AllowedHosts": "*"
}
