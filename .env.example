# Copy this file to .env (ignored by Git) and replace every placeholder password.
# Each placeholder appears twice: in its variable and in the Password= segment of the
# matching connection string. Replace all four occurrences.
# Compose reads .env for interpolation; plain `dotnet run` does not load it.
#
# The setup and runtime connection strings below use the Compose service name
# "sqlserver". For commands run from the host, replace "sqlserver" with
# "localhost" (the SQL port is published to loopback only).

MSSQL_SA_PASSWORD=ChangeMe_Local_Sa_Password1!
Scheduler__RuntimePassword=ChangeMe_Local_Runtime_Password1!
MSSQL_PID=Developer

ConnectionStrings__Setup=Server=sqlserver,1433;Database=ServiceScheduler;User Id=sa;Password=ChangeMe_Local_Sa_Password1!;Encrypt=True;TrustServerCertificate=True;Connect Timeout=10
ConnectionStrings__Runtime=Server=sqlserver,1433;Database=ServiceScheduler;User Id=scheduler_app;Password=ChangeMe_Local_Runtime_Password1!;Encrypt=True;TrustServerCertificate=True;Connect Timeout=3

# The API uses this optional catalog cache. It is not a startup gate: an unreachable
# Redis endpoint makes readiness Degraded (HTTP 200) while SQL Server stays authoritative.
# For commands run on the host, use ConnectionStrings__Cache=127.0.0.1:6379 instead.
ConnectionStrings__Cache=redis:6379

ASPNETCORE_ENVIRONMENT=Development

# Telemetry is enabled explicitly by compose.yaml for the api service. A host `dotnet run`
# needs these values to export; telemetry is disabled by default and never gates booking or
# readiness. No new secret is required for the local loopback Grafana/Tempo/Prometheus stack.
# Scheduler__Telemetry__Enabled=true
# Scheduler__Telemetry__OtlpEndpoint=http://127.0.0.1:4317
# Scheduler__Telemetry__SamplingRatio=1.0
